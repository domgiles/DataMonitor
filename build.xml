<?xml version="1.0" encoding="UTF-8"?>
<project name="new-data-monitor" default="compile" basedir="." xmlns:ivy="antlib:org.apache.ivy.ant">

    <!-- ==================== Project Properties ==================== -->
    <property name="project.name"    value="new-data-monitor"/>
    <property name="project.version" value="1.0.0"/>
    <property name="main.class"      value="com.dom.datamonitor.DataMonitor"/>

    <!-- Directory layout -->
    <property name="src.dir"         value="src/main/java"/>
    <property name="res.dir"         value="src/main/resources"/>
    <property name="build.dir"       value="build"/>
    <property name="classes.dir"     value="${build.dir}/classes"/>
    <property name="jar.file"        value="${build.dir}/datamonitor.jar"/>
    <property name="jar.deps.dir"    value="${build.dir}/jar-deps"/>
    <!-- Launcher scripts and config (src/dist) and the directory users get, zipped by 'zip' -->
    <property name="dist.src.dir"    value="src/dist"/>
    <property name="release.dir"     value="DataMonitor"/>
    <property name="docs.dir"        value="docs"/>
    <property name="lib.dir"         value="lib"/>

    <!-- Test layout -->
    <property name="test.src.dir"     value="src/test/java"/>
    <property name="test.res.dir"     value="src/test/resources"/>
    <property name="test.classes.dir" value="${build.dir}/test-classes"/>
    <property name="test.reports.dir" value="${build.dir}/test-reports"/>

    <!-- Config file used by 'ant run'; override with -Dconfig=/path/to/file.yaml -->
    <property name="config"          value="datamonitor.yaml"/>
    <!-- Extra command-line arguments for run / run-web, e.g. -Dargs="(flags)"; see README -->
    <property name="args"            value=""/>

    <!-- Ivy bootstrap -->
    <property name="ivy.install.version" value="2.5.2"/>
    <property name="ivy.jar.dir"         value="${basedir}/ivy"/>
    <property name="ivy.jar.file"        value="${ivy.jar.dir}/ivy-${ivy.install.version}.jar"/>

    <!-- ==================== Ivy Bootstrap ==================== -->
    <target name="download-ivy">
        <mkdir dir="${ivy.jar.dir}"/>
        <get src="https://repo1.maven.org/maven2/org/apache/ivy/ivy/${ivy.install.version}/ivy-${ivy.install.version}.jar"
             dest="${ivy.jar.file}" usetimestamp="true" skipexisting="true"/>
    </target>

    <target name="install-ivy" depends="download-ivy" description="Install Ivy">
        <path id="ivy.lib.path">
            <fileset dir="${ivy.jar.dir}" includes="*.jar"/>
        </path>
        <taskdef resource="org/apache/ivy/ant/antlib.xml"
                 uri="antlib:org.apache.ivy.ant"
                 classpathref="ivy.lib.path"/>
    </target>

    <target name="resolve" depends="install-ivy" description="Resolve dependencies">
        <ivy:resolve/>
        <ivy:retrieve pattern="${lib.dir}/[conf]/[artifact]-[revision].[ext]" sync="true"/>
    </target>

    <!-- ==================== Classpaths ==================== -->
    <path id="compile.classpath">
        <fileset dir="${lib.dir}/compile" includes="*.jar" erroronmissingdir="false"/>
    </path>

    <path id="runtime.classpath">
        <path refid="compile.classpath"/>
        <fileset dir="${lib.dir}/runtime" includes="*.jar" erroronmissingdir="false"/>
        <pathelement location="${classes.dir}"/>
    </path>

    <path id="test.classpath">
        <fileset dir="${lib.dir}/test" includes="*.jar" erroronmissingdir="false"/>
        <pathelement location="${classes.dir}"/>
        <pathelement location="${test.classes.dir}"/>
    </path>

    <!-- ==================== Core Targets ==================== -->
    <target name="init">
        <mkdir dir="${classes.dir}"/>
    </target>

    <target name="clean" description="Remove all generated files">
        <delete dir="${build.dir}"   quiet="true"/>
        <delete dir="${docs.dir}"    quiet="true"/>
        <delete dir="${release.dir}" quiet="true"/>
    </target>

    <target name="compile" depends="init,resolve" description="Compile source code">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               classpathref="compile.classpath"
               source="17" target="17" release="17"
               encoding="UTF-8"
               debug="true"
               fork="true"
               includeantruntime="false">
            <compilerarg value="-Xlint:deprecation"/>
        </javac>
        <!-- Copy resources into classes -->
        <copy todir="${classes.dir}" failonerror="false">
            <fileset dir="${res.dir}" includes="**/*" erroronmissingdir="false"/>
        </copy>
        <!-- Single source of truth for the version: read by DataMonitor at runtime -->
        <echo file="${classes.dir}/com/dom/datamonitor/version.properties">version=${project.version}${line.separator}</echo>
    </target>

    <!-- ==================== Tests ==================== -->
    <target name="compile.test" depends="compile" description="Compile test sources">
        <mkdir dir="${test.classes.dir}"/>
        <javac srcdir="${test.src.dir}"
               destdir="${test.classes.dir}"
               classpathref="test.classpath"
               release="17"
               encoding="UTF-8"
               debug="true"
               fork="true"
               includeantruntime="false">
            <compilerarg value="-Xlint:deprecation"/>
        </javac>
        <copy todir="${test.classes.dir}" failonerror="false">
            <fileset dir="${test.res.dir}" includes="**/*" erroronmissingdir="false"/>
        </copy>
    </target>

    <target name="test" depends="compile.test" description="Run all unit tests; fails the build on any failure">
        <mkdir dir="${test.reports.dir}"/>
        <!-- JUnit Platform console launcher; exits non-zero if any test fails -->
        <java classname="org.junit.platform.console.ConsoleLauncher"
              classpathref="test.classpath"
              fork="true"
              failonerror="true">
            <jvmarg value="-Djava.awt.headless=true"/>
            <arg value="execute"/>
            <arg value="--scan-classpath"/>
            <arg value="${test.classes.dir}"/>
            <arg value="--reports-dir=${test.reports.dir}"/>
            <arg value="--details=tree"/>
            <arg value="--disable-banner"/>
        </java>
    </target>

    <target name="jar" depends="compile" description="Package build/datamonitor.jar: the application and all its libraries in one JAR">
        <!-- Unpack the runtime libraries so their manifests, signatures and module descriptors
             can be left out (none is signed; only ojdbc17 has META-INF/services files, so
             nothing clashes). SnakeYAML ships Java 9+ classes under META-INF/versions, hence
             Multi-Release. -->
        <delete dir="${jar.deps.dir}" quiet="true"/>
        <unzip dest="${jar.deps.dir}" overwrite="true">
            <fileset dir="${lib.dir}/runtime" includes="*.jar" erroronmissingdir="false"/>
            <patternset>
                <exclude name="META-INF/MANIFEST.MF"/>
                <exclude name="META-INF/*.SF"/>
                <exclude name="META-INF/*.RSA"/>
                <exclude name="META-INF/*.DSA"/>
                <exclude name="META-INF/INDEX.LIST"/>
                <exclude name="**/module-info.class"/>
            </patternset>
        </unzip>
        <jar destfile="${jar.file}">
            <fileset dir="${classes.dir}"/>
            <fileset dir="${jar.deps.dir}"/>
            <manifest>
                <attribute name="Main-Class"             value="${main.class}"/>
                <attribute name="Multi-Release"          value="true"/>
                <attribute name="Implementation-Title"   value="DataMonitor"/>
                <attribute name="Implementation-Version" value="${project.version}"/>
            </manifest>
        </jar>
    </target>

    <target name="dist" depends="clean,jar" description="Assemble the DataMonitor/ distribution directory">
        <!-- bin/ and winbin/ scripts, launcher/ (Apache Commons Launcher) and lib/launcher/ -->
        <copy todir="${release.dir}">
            <fileset dir="${dist.src.dir}"/>
        </copy>
        <copy file="${jar.file}"                   todir="${release.dir}/lib"/>
        <copy file="${basedir}/datamonitor.yaml"   todir="${release.dir}/bin"/>
        <copy file="${basedir}/README.md"          todir="${release.dir}"/>
        <!-- copy does not keep file modes -->
        <chmod dir="${release.dir}/bin" includes="datamonitor,datamonitorweb" perm="755"/>

        <echo message=""/>
        <echo message="Distribution ready in ${release.dir}/"/>
        <echo message="  bin/datamonitor, bin/datamonitorweb       - macOS / Linux commands"/>
        <echo message="  winbin/datamonitor.bat, datamonitorweb.bat - Windows commands"/>
        <echo message="  bin/datamonitor.yaml                      - configuration (edit before running)"/>
        <echo message="  lib/datamonitor.jar                       - the application and all its libraries"/>
        <echo message="  launcher/, lib/launcher/                  - Apache Commons Launcher"/>
    </target>

    <target name="zip" depends="dist" description="Zip DataMonitor/ as datamonitorDDMMYYYY.zip in the project root">
        <tstamp>
            <format property="dist.date" pattern="ddMMyyyy"/>
        </tstamp>
        <zip destfile="${basedir}/datamonitor${dist.date}.zip">
            <zipfileset dir="${release.dir}" prefix="DataMonitor"
                        excludes="bin/datamonitor,bin/datamonitorweb" filemode="644" dirmode="755"/>
            <zipfileset dir="${release.dir}" prefix="DataMonitor"
                        includes="bin/datamonitor,bin/datamonitorweb" filemode="755"/>
        </zip>
        <echo message="Archive: ${basedir}/datamonitor${dist.date}.zip"/>
    </target>

    <target name="run" depends="compile" description="Run the application">
        <java classname="${main.class}"
              classpathref="runtime.classpath"
              fork="true">
            <jvmarg value="-Dawt.useSystemAAFontSettings=on"/>
            <jvmarg value="-Dswing.aatext=true"/>
            <arg value="-c"/>
            <arg file="${config}"/>
            <arg line="${args}"/>
        </java>
    </target>

    <target name="run-web" depends="compile" description="Run the web front end (link with access token is printed; Ctrl+C to stop)">
        <java classname="${main.class}"
              classpathref="runtime.classpath"
              fork="true">
            <arg value="-c"/>
            <arg file="${config}"/>
            <arg value="--web"/>
            <arg line="${args}"/>
        </java>
    </target>

    <target name="docs" depends="compile" description="Generate JavaDoc">
        <mkdir dir="${docs.dir}"/>
        <javadoc sourcepath="${src.dir}"
                 destdir="${docs.dir}"
                 classpathref="compile.classpath"
                 source="17"
                 encoding="UTF-8"
                 windowtitle="${project.name} ${project.version}"
                 failonerror="false"/>
    </target>

    <target name="all" depends="clean,compile,jar" description="Full build: clean → compile → jar"/>

</project>
