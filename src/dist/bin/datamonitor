#!/bin/sh
# Runs the datamonitor target in ../launcher/launcher.xml from this directory, so the
# datamonitor.yaml next to this script is used unless -c names another file.
cd "$(dirname "$0")"
# --encrypt prompts for a password, which needs this terminal: the launcher's child JVM has none
if [ "$1" = "--encrypt" ]; then
    exec java -jar ../lib/datamonitor.jar "$@"
fi
exec java -cp ../launcher LauncherBootstrap -executablename datamonitor datamonitor "$@"
